# --- Required -------------------------------------------------------------
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# --- Model ----------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is throttled or unavailable.
GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.8-flash

# The name Hudu answers to and introduces itself with
AGENT_NAME=Hudu

# --- Speech to text -------------------------------------------------------
# gemini = send mic audio straight to Gemini (works with the key above)
# cloud  = Google Cloud Speech-to-Text (needs GOOGLE_APPLICATION_CREDENTIALS)
STT_BACKEND=gemini

# Path to your service-account JSON, used only when STT_BACKEND=cloud
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/keys/gcp-speech.json
GOOGLE_CLOUD_PROJECT=

# --- Behaviour ------------------------------------------------------------
WAKE_WORD=hudu
WAKE_WORD_REQUIRED=true
TTS_ENABLED=true
TTS_RATE=175
TTS_VOICE_INDEX=0
MAX_RECORD_SECONDS=20
HISTORY_TURNS=12
